/* ── Panel overlay + slide-in panel ─────────────────────────────────────── */

.panel-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(12, 10, 7, 0);
    transition-property: background-color, opacity;
    transition-duration: 0.4s;
    display: none;
    opacity: 0;
}

.panel-overlay.visible {
    background-color: rgba(12, 10, 7, 0.65);
    display: flex;
    justify-content: flex-end;
    opacity: 1;
}

.panel {
    width: 480px;
    max-width: 100%;
    height: 100%;
    background-color: rgba(246, 241, 232, 1);
    flex-direction: column;
    overflow: scroll;
    translate: 36px 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.5s;
}

.panel-overlay.visible > .panel {
    translate: 0 0;
    opacity: 1;
}

/* ── Language step ───────────────────────────────────────────────────────── */

.lang-step {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 64px 48px 56px;
}

/* IM Fell English Regular — font set in tokens.uss */
.lang-ornament {
    font-size: 11px;
    color: rgba(170, 140, 80, 1);
    margin-bottom: 32px;
    -unity-text-align: upper-center;
}

/* IM Fell English Italic — font set in tokens.uss */
.lang-step-title {
    font-size: 24px;
    color: rgba(28, 22, 14, 1);
    -unity-text-align: upper-center;
    margin-bottom: 10px;
    white-space: normal;
}

/* Lora Italic — font set in tokens.uss */
.lang-step-alts {
    font-size: 12px;
    color: rgba(90, 80, 64, 1);
    -unity-text-align: upper-center;
    margin-bottom: 38px;
    white-space: normal;
}

.lang-rule {
    width: 28px;
    height: 1px;
    background-color: rgba(110, 90, 65, 0.28);
    margin-bottom: 38px;
}

.lang-options {
    flex-direction: column;
    align-items: center;
    width: 200px;
}

/* Lora Regular — base font from .root */
.lang-btn {
    font-size: 14px;
    color: rgba(60, 50, 36, 1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(110, 90, 65, 0.28);
    border-radius: 0;
    padding: 13px 0;
    margin-bottom: 8px;
    width: 200px;
    transition-property: border-color, color;
    transition-duration: 0.2s;
}

.lang-btn:hover {
    border-color: rgba(122, 51, 32, 1);
    color: rgba(122, 51, 32, 1);
}

/* ── Form step ───────────────────────────────────────────────────────────── */

.form-step {
    flex-direction: column;
    flex-grow: 1;
}

.form-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    padding: 24px 36px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(110, 90, 65, 0.14);
    margin-bottom: 0;
}

/* IM Fell English Italic — font set in tokens.uss */
.form-heading {
    font-size: 19px;
    color: rgba(28, 22, 14, 1);
    white-space: normal;
    flex-grow: 1;
}

.form-meta {
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
}

/* Lora Italic — font set in tokens.uss */
.form-date {
    font-size: 10px;
    color: rgba(90, 80, 64, 1);
    margin-bottom: 6px;
}

/* Lora Regular — base */
.lang-pill {
    font-size: 9px;
    color: rgba(90, 80, 64, 1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(110, 90, 65, 0.28);
    border-radius: 0;
    padding: 3px 9px;
}

/* ── Book row: cover + details ───────────────────────────────────────────── */

.book-row {
    flex-direction: row;
    padding: 22px 36px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(110, 90, 65, 0.14);
}

.cover-col {
    width: 90px;
    flex-direction: column;
    align-items: center;
    margin-right: 24px;
}

.cover-frame {
    width: 90px;
    height: 128px;
    background-color: rgba(240, 233, 218, 1);
    border-width: 1px;
    border-color: rgba(110, 90, 65, 0.28);
    border-radius: 0;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    overflow: hidden;
}

.cover-placeholder {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.cover-placeholder-icon {
    font-size: 20px;
    color: rgba(90, 80, 64, 0.3);
    margin-bottom: 7px;
}

/* Lora Regular */
.cover-placeholder-label {
    font-size: 8px;
    color: rgba(90, 80, 64, 0.45);
}

.cover-loader {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.cover-dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(90, 80, 64, 0.6);
    margin-left: 2px;
    margin-right: 2px;
}

.cover-image {
    width: 90px;
    height: 128px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Lora Italic — font set in tokens.uss */
.find-cover-btn {
    font-size: 10px;
    color: rgba(122, 51, 32, 1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

.find-cover-btn:hover {
    color: rgba(168, 72, 48, 1);
}

.find-cover-btn:disabled {
    color: rgba(90, 80, 64, 1);
    opacity: 0.5;
}

/* ── Details column ──────────────────────────────────────────────────────── */

.details-col {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.field-group {
    flex-direction: column;
    margin-bottom: 18px;
}

/* Lora Regular */
.field-label {
    font-size: 8px;
    color: rgba(90, 80, 64, 1);
    margin-bottom: 5px;
}

/* IM Fell English Regular — font set in tokens.uss */
.field-input {
    font-size: 15px;
    color: rgba(28, 22, 14, 1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0 0 1px 0;
    border-color: rgba(110, 90, 65, 0.28);
    border-radius: 0;
    padding: 5px 0 7px;
}

.field-input:focus {
    border-color: rgba(122, 51, 32, 1);
}

.field-input.has-error {
    border-color: rgba(168, 72, 48, 1);
}

/* Lora Italic — font set in tokens.uss */
.field-err {
    font-size: 9px;
    color: rgba(168, 72, 48, 1);
    margin-top: 4px;
}

/* ── Response textarea ───────────────────────────────────────────────────── */

.response-section {
    flex-direction: column;
    padding: 20px 36px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(110, 90, 65, 0.14);
}

/* Lora Regular */
.response-label {
    font-size: 8px;
    color: rgba(90, 80, 64, 1);
    margin-bottom: 12px;
}

/* Lora Italic — font set in tokens.uss */
.response-textarea {
    font-size: 14px;
    color: rgba(28, 22, 14, 1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 0;
    min-height: 108px;
    white-space: normal;
}

/* ── Checkboxes ──────────────────────────────────────────────────────────── */

.checks-section {
    flex-direction: column;
    padding: 16px 36px 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(110, 90, 65, 0.14);
}

.check-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 10px;
}

/* Lora Italic — font set in tokens.uss */
.check-label {
    font-size: 12px;
    color: rgba(60, 50, 36, 1);
    margin-left: 11px;
    white-space: normal;
}

/* ── Form actions ────────────────────────────────────────────────────────── */

/* Lora Italic — font set in tokens.uss */
.submit-err {
    font-size: 10px;
    color: rgba(168, 72, 48, 1);
    padding: 10px 36px 0;
    white-space: normal;
}

.form-actions {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 20px 36px 32px;
    margin-top: auto;
}

/* Lora Italic — font set in tokens.uss */
.cancel-btn {
    font-size: 10px;
    color: rgba(90, 80, 64, 1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

.cancel-btn:hover {
    color: rgba(60, 50, 36, 1);
}

/* Lora Italic — font set in tokens.uss */
.submit-btn {
    font-size: 10px;
    color: rgba(246, 241, 232, 1);
    background-color: rgba(122, 51, 32, 1);
    border-width: 0;
    border-radius: 0;
    padding: 11px 26px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.submit-btn:hover {
    background-color: rgba(168, 72, 48, 1);
}

.submit-btn:disabled {
    opacity: 0.5;
}

/* ── Confirm step ────────────────────────────────────────────────────────── */

.confirm-step {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 48px 56px;
}

/* IM Fell English Regular — font set in tokens.uss */
.confirm-ornament {
    font-size: 22px;
    color: rgba(170, 140, 80, 0.6);
    margin-bottom: 22px;
    -unity-text-align: upper-center;
}

/* IM Fell English Italic — font set in tokens.uss */
.confirm-heading {
    font-size: 20px;
    color: rgba(28, 22, 14, 1);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 12px;
}

/* Lora Italic — font set in tokens.uss */
.confirm-body {
    font-size: 13px;
    color: rgba(90, 80, 64, 1);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 36px;
}

.confirm-actions {
    flex-direction: column;
    align-items: center;
    width: 230px;
}

/* Lora Italic — font set in tokens.uss */
.confirm-yes {
    font-size: 10px;
    color: rgba(246, 241, 232, 1);
    background-color: rgba(122, 51, 32, 1);
    border-width: 0;
    border-radius: 0;
    padding: 12px 0;
    margin-bottom: 8px;
    width: 230px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.confirm-yes:hover {
    background-color: rgba(168, 72, 48, 1);
}

/* Lora Italic — font set in tokens.uss */
.confirm-no {
    font-size: 10px;
    color: rgba(60, 50, 36, 1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(110, 90, 65, 0.28);
    border-radius: 0;
    padding: 11px 0;
    width: 230px;
    transition-property: border-color, color;
    transition-duration: 0.2s;
}

.confirm-no:hover {
    border-color: rgba(60, 50, 36, 1);
    color: rgba(28, 22, 14, 1);
}

/* ── Thanks step ─────────────────────────────────────────────────────────── */

.thanks-step {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 72px 48px 64px;
}

/* IM Fell English Regular — font set in tokens.uss */
.thanks-ornament {
    font-size: 11px;
    color: rgba(170, 140, 80, 1);
    margin-bottom: 32px;
    -unity-text-align: upper-center;
}

/* IM Fell English Italic — font set in tokens.uss */
.thanks-heading {
    font-size: 23px;
    color: rgba(28, 22, 14, 1);
    -unity-text-align: upper-center;
    margin-bottom: 14px;
}

/* Lora Italic — font set in tokens.uss */
.thanks-body {
    font-size: 14px;
    color: rgba(90, 80, 64, 1);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 40px;
}

/* Lora Italic — font set in tokens.uss */
.thanks-close {
    font-size: 10px;
    color: rgba(60, 50, 36, 1);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(110, 90, 65, 0.28);
    border-radius: 0;
    padding: 12px 28px;
    transition-property: border-color, color;
    transition-duration: 0.2s;
}

.thanks-close:hover {
    border-color: rgba(60, 50, 36, 1);
    color: rgba(28, 22, 14, 1);
}
